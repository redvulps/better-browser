{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Better Browser",
  "version": "0.5.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "permissions": ["tabGroups", "webNavigation", "scripting", "storage", "alarms", "debugger", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Better Browser" }
}
