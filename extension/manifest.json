{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Better Browser",
  "version": "0.3.3",
  "description": "Conecte um agente via MCP ao Chrome ou Brave para abrir, ler e controlar abas em um grupo por conversa.",
  "permissions": ["tabGroups", "webNavigation", "scripting", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Better Browser" }
}
